<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Smart Attendance System</title>

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

<style>
*{box-sizing:border-box}
body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#f0f4fa;
  color:#172554;
}
header{
  background:#2563eb;
  color:white;
  padding:20px;
  text-align:center;
}
nav{
  display:flex;
  flex-wrap:wrap;
  justify-content:center;
  gap:10px;
  background:white;
  padding:15px;
}
button{
  background:#2563eb;
  color:white;
  border:0;
  border-radius:10px;
  padding:13px 17px;
  font-size:16px;
  cursor:pointer;
  touch-action:manipulation;
}
button:hover{background:#1d4ed8}
main{max-width:850px;margin:20px auto;padding:12px}
.card{
  background:white;
  border-radius:18px;
  padding:22px;
  margin-bottom:20px;
  box-shadow:0 3px 15px #0000000c;
}
h2{color:#1e3a8a}
input,select{
  width:100%;
  padding:13px;
  margin:8px 0 15px;
  border:1px solid #cbd5e1;
  border-radius:8px;
  font-size:16px;
}
#qrcode{
  display:flex;
  justify-content:center;
  padding:20px;
  min-height:40px;
}
#qrcode img,#qrcode canvas{
  max-width:100%;
}
.info{
  background:#dbeafe;
  padding:14px;
  border-radius:10px;
  margin:12px 0;
  overflow-wrap:anywhere;
}
.hidden{display:none!important}
table{width:100%;border-collapse:collapse}
th,td{padding:10px;border:1px solid #cbd5e1;text-align:left}
.small{font-size:13px;color:#475569}
</style>
</head>

<body>
<header>
  <h1>AI Smart Attendance</h1>
  <p>College Attendance Management System</p>
</header>

<nav>
  <button type="button" onclick="showSection('home')">Dashboard</button>
  <button type="button" onclick="showSection('timetable')">Weekly Timetable</button>
  <button type="button" onclick="showSection('qrSection')">Generate QR</button>
  <button type="button" onclick="showSection('report')">Attendance Report</button>
  <button type="button" onclick="logout()">Logout</button>
</nav>

<main>
  <section class="card" id="home">
    <h2 id="welcome">Welcome</h2>
    <div class="info">Total Students: <strong>106</strong></div>
    <div class="info">Login Type: <strong id="roleText">Staff</strong></div>
    <p class="small">Demo version: attendance is stored only in this browser.</p>
  </section>

  <section class="card hidden" id="qrSection">
    <h2>Generate Attendance QR</h2>
    <p>Only staff should generate the lecture QR code.</p>

    <label for="subject">Select Subject</label>
    <select id="subject">
      <option>Chemistry</option>
      <option>Engineering Mathematics-I</option>
      <option>Verbal Communication Skills</option>
      <option>Environmental Science</option>
      <option>Computational Thinking & Problem Solving</option>
      <option>Physics</option>
      <option>Communication</option>
      <option>Yoga and Meditation</option>
      <option>Computer Workshop Practice</option>
      <option>Introduction to AI Tools</option>
      <option>Mandatory Course-I</option>
    </select>

    <label for="lecture">Lecture Number</label>
    <select id="lecture">
      <option value="1">Lecture 1</option>
      <option value="2">Lecture 2</option>
      <option value="3">Lecture 3</option>
      <option value="4">Lecture 4</option>
      <option value="5">Lecture 5</option>
    </select>

    <div class="info">
      <strong>QR refresh:</strong> Every 10 seconds
      <p>Next refresh in: <strong id="countdown">10</strong> seconds</p>
      <p>QR status: <strong id="qrStatus">Waiting</strong></p>
    </div>

    <div id="qrcode"></div>
    <p id="qrMessage" class="small" aria-live="polite"></p>

    <button type="button" onclick="generateQR()">Generate / Refresh QR</button>
  </section>

  <section class="card hidden" id="timetable">
    <h2>Weekly Timetable</h2>
    <div style="overflow-x:auto">
      <table>
        <thead><tr><th>Day</th><th>Lecture</th><th>Subject</th><th>Time</th></tr></thead>
        <tbody>
          <tr><td>Monday</td><td>1</td><td>Chemistry</td><td>10:00–10:50</td></tr>
          <tr><td>Monday</td><td>2</td><td>Engineering Mathematics-I</td><td>10:50–11:50</td></tr>
          <tr><td>Monday</td><td>3</td><td>Verbal Communication Skills</td><td>12:30–2:30</td></tr>
          <tr><td>Monday</td><td>4</td><td>Chemistry</td><td>2:50–4:50</td></tr>
          <tr><td>Tuesday</td><td>1</td><td>Environmental Science</td><td>10:00–10:50</td></tr>
          <tr><td>Tuesday</td><td>2</td><td>Engineering Mathematics-I</td><td>10:50–11:50</td></tr>
          <tr><td>Tuesday</td><td>3</td><td>Computational Thinking & Problem Solving</td><td>12:30–2:30</td></tr>
          <tr><td>Tuesday</td><td>4</td><td>Computational Thinking & Problem Solving</td><td>2:50–3:50</td></tr>
          <tr><td>Tuesday</td><td>5</td><td>Physics</td><td>3:50–4:50</td></tr>
          <tr><td>Wednesday</td><td>1</td><td>Communication</td><td>10:00–10:50</td></tr>
          <tr><td>Wednesday</td><td>2</td><td>Chemistry</td><td>10:50–11:50</td></tr>
          <tr><td>Wednesday</td><td>3</td><td>Computational Thinking & Problem Solving</td><td>12:30–1:30</td></tr>
          <tr><td>Wednesday</td><td>4</td><td>Engineering Mathematics-I</td><td>1:30–2:30</td></tr>
          <tr><td>Wednesday</td><td>5</td><td>Yoga and Meditation</td><td>2:30–4:50</td></tr>
          <tr><td>Thursday</td><td>1</td><td>Physics</td><td>Time to confirm</td></tr>
          <tr><td>Thursday</td><td>2</td><td>Environmental Science</td><td>10:55–11:50</td></tr>
          <tr><td>Thursday</td><td>3</td><td>Computer Workshop Practice</td><td>12:30–2:30</td></tr>
          <tr><td>Thursday</td><td>4</td><td>Computer Workshop Practice</td><td>2:50–4:50</td></tr>
          <tr><td>Friday</td><td>1</td><td>Engineering Mathematics-I</td><td>10:00–10:55</td></tr>
          <tr><td>Friday</td><td>2</td><td>Computational Thinking & Problem Solving</td><td>10:55–11:50</td></tr>
          <tr><td>Friday</td><td>3</td><td>Computer Workshop Practice</td><td>12:30–2:30</td></tr>
          <tr><td>Friday</td><td>4</td><td>Introduction to AI Tools</td><td>2:50–4:50</td></tr>
          <tr><td>Saturday</td><td>1</td><td>Mandatory Course-I</td><td>2:50–4:50</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="card hidden" id="report">
    <h2>Attendance Report</h2>
    <p id="reportCount">No demo attendance recorded.</p>
    <div style="overflow-x:auto">
      <table>
        <thead><tr><th>Student ID</th><th>Subject</th><th>Date</th></tr></thead>
        <tbody id="reportRows"></tbody>
      </table>
    </div>
    <br>
    <button type="button" onclick="downloadCSV()">Download CSV</button>
  </section>

  <section class="card" id="studentSection">
    <h2>Student Demo Attendance</h2>
    <p class="small">Demo only. This button does not scan a QR code.</p>
    <label for="studentId">Student ID</label>
    <input id="studentId" placeholder="Enter your student ID">
    <button type="button" onclick="demoAttendance()">Mark Demo Attendance</button>
    <p id="studentMessage" aria-live="polite"></p>
  </section>
</main>

<script>
const user = sessionStorage.getItem("attendanceUser");
const role = (sessionStorage.getItem("attendanceRole") || "").toLowerCase();
const userId = sessionStorage.getItem("attendanceUserId") || "";

if (!user || !["staff", "student"].includes(role)) {
  document.getElementById("welcome").textContent =
    "Demo Dashboard — open login first if needed";
} else {
  document.getElementById("welcome").textContent = "Welcome, " + user + "!";
}

document.getElementById("roleText").textContent =
  role ? role.charAt(0).toUpperCase() + role.slice(1) : "Demo";

if (role === "student") {
  document.getElementById("qrSection").classList.add("hidden");
  document.getElementById("studentId").value = userId;
} else {
  document.getElementById("studentSection").classList.add("hidden");
}

let qrTimer = null;
let countdownTimer = null;
let secondsLeft = 10;
let qrSequence = 0;

function showSection(id) {
  if (id === "qrSection" && role !== "staff") {
    alert("Staff login is required to generate QR.");
    return;
  }
  ["home", "timetable", "qrSection", "report"].forEach(sectionId => {
    document.getElementById(sectionId).classList.add("hidden");
  });
  document.getElementById(id).classList.remove("hidden");

  if (id === "qrSection" && !qrTimer) generateQR();
  if (id === "report") renderReport();
}

function generateQR() {
  if (role !== "staff") {
    alert("Please login as Staff to generate QR.");
    return;
  }

  if (typeof QRCode === "undefined") {
    document.getElementById("qrMessage").textContent =
      "QR library did not load. Check your internet connection and refresh.";
    return;
  }

  clearInterval(qrTimer);
  clearInterval(countdownTimer);

  function refresh() {
    const now = Date.now();
    const payload = {
      type: "DEMO_ATTENDANCE",
      subject: document.getElementById("subject").value,
      lecture: document.getElementById("lecture").value,
      issuedAt: now,
      expiresAt: now + 10000,
      token: String(now) + "-" + (++qrSequence)
    };

    const container = document.getElementById("qrcode");
    container.innerHTML = "";
    new QRCode(container, {
      text: JSON.stringify(payload),
      width: 220,
      height: 220,
      correctLevel: QRCode.CorrectLevel.M
    });

    secondsLeft = 10;
    document.getElementById("countdown").textContent = secondsLeft;
    document.getElementById("qrStatus").textContent = "Active demo QR";
    document.getElementById("qrMessage").textContent =
      "Demo QR refreshed. It expires after 10 seconds; a new QR will appear automatically.";
  }

  refresh();
  qrTimer = setInterval(refresh, 10000);
  countdownTimer = setInterval(() => {
    secondsLeft = Math.max(0, secondsLeft - 1);
    document.getElementById("countdown").textContent = secondsLeft;
  }, 1000);
}

function getRecords() {
  try {
    return JSON.parse(localStorage.getItem("demoAttendanceRecords") || "[]");
  } catch {
    return [];
  }
}

function demoAttendance() {
  const id = document.getElementById("studentId").value.trim();
  if (!id) {
    document.getElementById("studentMessage").textContent =
      "Please enter a Student ID.";
    return;
  }

  const records = getRecords();
  const subject = "Demo attendance";
  const today = new Date().toLocaleDateString();

  if (records.some(r => r.id === id && r.date === today && r.subject === subject)) {
    document.getElementById("studentMessage").textContent =
      "Demo attendance already recorded today.";
    return;
  }

  records.push({id, subject, date: today});
  localStorage.setItem("demoAttendanceRecords", JSON.stringify(records));
  document.getElementById("studentMessage").textContent =
    "Demo attendance saved in this browser only.";
}

function renderReport() {
  const records = getRecords();
  document.getElementById("reportCount").textContent =
    records.length + " demo record(s).";
  document.getElementById("reportRows").innerHTML = records.map(r =>
    "<tr><td></td><td></td><td></td></tr>"
  ).join("");

  Array.from(document.getElementById("reportRows").rows).forEach((row, i) => {
    const r = records[i];
    row.cells[0].textContent = r.id;
    row.cells[1].textContent = r.subject;
    row.cells[2].textContent = r.date;
  });
}

function downloadCSV() {
  const records = getRecords();
  const rows = [["Student ID", "Subject", "Date"],
    ...records.map(r => [r.id, r.subject, r.date])];
  const csv = rows.map(row => row.map(value =>
    '"' + String(value).replace(/"/g, '""') + '"'
  ).join(",")).join("\r\n");

  const blob = new Blob(["\uFEFF" + csv], {type: "text/csv;charset=utf-8;"});
  const url = URL.createObjectURL(blob);
  const link = document.createElement("a");
  link.href = url;
  link.download = "attendance-report.csv";
  document.body.appendChild(link);
  link.click();
  link.remove();
  URL.revokeObjectURL(url);
}

function logout() {
  clearInterval(qrTimer);
  clearInterval(countdownTimer);
  sessionStorage.removeItem("attendanceUser");
  sessionStorage.removeItem("attendanceRole");
  sessionStorage.removeItem("attendanceUserId");
  window.location.href = "index.html";
}
</script>
</body>
</html>
