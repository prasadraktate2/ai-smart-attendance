<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student QR Scanner</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      padding: 20px;
      background: #f1f5f9;
      font-family: Arial, sans-serif;
      color: #172033;
    }
    .container {
      max-width: 600px;
      margin: 25px auto;
      padding: 22px;
      background: white;
      border-radius: 14px;
      text-align: center;
    }
    h1 { color: #123b73; }
    button {
      width: 100%;
      padding: 12px;
      margin: 8px 0;
      border: 0;
      border-radius: 7px;
      background: #123b73;
      color: white;
      font-weight: bold;
      cursor: pointer;
    }
    #reader { width: 100%; margin: 15px auto; }
    #result {
      padding: 12px;
      background: #eff6ff;
      border-radius: 8px;
      overflow-wrap: anywhere;
      text-align: left;
    }
    .note { color: #64748b; font-size: 13px; line-height: 1.5; }
    a { color: #123b73; }
  </style>
</head>
<body>
  <div class="container">
    <h1>📷 Student QR Scanner</h1>
    <p>Scan the QR code shown by your teacher.</p>

    <button onclick="startScanner()">Start Camera Scanner</button>
    <button onclick="stopScanner()">Stop Scanner</button>

    <div id="reader"></div>
    <div id="result">Scan a QR code to view its details.</div>

    <p class="note">
      Prototype only: this page reads QR data but does not verify the
      teacher, prevent forged QR codes, or save official attendance.
    </p>
    <p><a href="dashboard.html">← Back to Dashboard</a></p>
  </div>

  <script src="https://unpkg.com/html5-qrcode"></script>
  <script>
    let scanner = null;
    let running = false;

    async function startScanner() {
      const role = sessionStorage.getItem("attendanceRole");

      if (role !== "Student") {
        document.getElementById("result").textContent =
          "Please log in using the Student option first.";
        return;
      }

      if (!window.Html5Qrcode) {
        document.getElementById("result").textContent =
          "Scanner library could not load. Check your internet.";
        return;
      }

      if (running) return;

      try {
        scanner = new Html5Qrcode("reader");
        await scanner.start(
          { facingMode: "environment" },
          { fps: 10, qrbox: { width: 220, height: 220 } },
          (decodedText) => {
            try {
              const data = JSON.parse(decodedText);

              if (!data.subject || !data.lecture || !data.expiresAt) {
                throw new Error("Invalid QR format");
              }

              if (Date.now() > Number(data.expiresAt)) {
                document.getElementById("result").textContent =
                  "QR expired. Ask your teacher to display a new QR.";
                return;
              }

              document.getElementById("result").textContent =
                "QR Read Successfully\nSubject: " + data.subject +
                "\nLecture: " + data.lecture +
                "\n\nThis is only a preview. Attendance has NOT been recorded.";
            } catch (error) {
              document.getElementById("result").textContent =
                "Invalid QR code. Scan the QR generated by the demo page.";
            }
          },
          () => {}
        );
        running = true;
        document.getElementById("result").textContent =
          "Camera started. Point it at the teacher's QR code.";
      } catch (error) {
        document.getElementById("result").textContent =
          "Camera could not start. Allow camera permission and open the HTTPS website.";
      }
    }

    async function stopScanner() {
      if (scanner && running) {
        try {
          await scanner.stop();
          scanner.clear();
        } catch (error) {}
      }
      scanner = null;
      running = false;
      document.getElementById("result").textContent = "Scanner stopped.";
    }
  </script>
</body>
</html>
